{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axodashboard",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axo-analytics-db",
      "database_id": "c3e0572b-79ff-4cf9-9783-c7aaf705edd0"
    }
  ],
  "keep_vars": true,
  "vars": {
    "GOOGLE_CLIENT_ID": "795193745293-7u5m68ni4tnlinrb3fjc0vnbunktng1o.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://axodashboard.denisnollan9.workers.dev/api/auth/youtube/callback",
    "META_APP_ID": "2520891861731114",
    "META_CONFIG_ID": "1288601726790079",
    "META_REDIRECT_URI": "https://axodashboard.denisnollan9.workers.dev/api/auth/instagram/callback"
  }
}
