{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axodashboard",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axo-analytics-db",
      "database_id": "c3e0572b-79ff-4cf9-9783-c7aaf705edd0"
    }
  ],
  "keep_vars": true
}
